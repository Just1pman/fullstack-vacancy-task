{
  "name": "users-directory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node dist/server/index.js",
    "dev": "node --watch --watch-path=server --watch-path=public --watch-path=contracts --watch-path=tsconfig.json scripts/dev.mjs",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3"
  }
}
