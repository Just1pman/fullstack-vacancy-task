{
  "compilerOptions": {
    "rootDir": "src/client",
    "outDir": "dist/client",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true
  },
  "include": ["src/client", "src/shared"],
  "exclude": ["src/client/*.test.ts"]
}
